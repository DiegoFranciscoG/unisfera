# Copie este archivo como .env y reemplace cada valor CAMBIAR (o ejecute scripts/generar-env.sh).
# Nunca versione .env. Los valores sin definir detienen el arranque: no hay secretos por defecto.

# ---- Base de datos (PostgreSQL)
DB_PASSWORD=CAMBIAR

# ---- Caché y sesiones revocadas (Valkey). Solo letras y números: va dentro de una URL.
REDIS_PASSWORD=CAMBIAR

# ---- Secretos de la aplicación (Base64; generar con: openssl rand -base64 48)
JWT_SECRET=CAMBIAR
# Exactamente 32 bytes en Base64 (AES-256): openssl rand -base64 32
SENSITIVE_DATA_KEY=CAMBIAR
ACT_SIGNING_KEY=CAMBIAR
GATEWAY_WEBHOOK_SECRET=CAMBIAR

# ---- Primer superadministrador (se crea una sola vez; debe cambiar la contraseña al ingresar)
# Cédula FICTICIA con dígito verificador válido (nunca la de una persona real).
SUPERADMIN_ID_NUMBER=CAMBIAR
SUPERADMIN_INITIAL_PASSWORD=CAMBIAR

# ---- Datos de demostración (ficticios)
SEED_DEMO_DATA=true
SEED_STUDENTS=1500
SEED_LOAD_TEST_STUDENTS=2000
# Contraseña común de las cuentas demo (mínimo 12 caracteres).
DEMO_PASSWORD=CAMBIAR

# ---- Opcionales
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:4200
COOKIE_SECURE=false
